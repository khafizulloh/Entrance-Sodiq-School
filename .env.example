# ----------------------------------------------------------------------------
# Sodiq School Entrance Test — Environment Variables
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/sodiq_school
# Supabase: use the "Connection string" (URI) from your project settings.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sodiq_school?schema=public"

# Secret used to sign admin session JWTs. Use a long random string in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# Credentials for the default admin user created by the seed script.
ADMIN_EMAIL="admin@sodiqschool.uz"
ADMIN_PASSWORD="Admin12345!"
ADMIN_NAME="Sodiq School Admin"

# ----------------------------------------------------------------------------
# Attendance tracker (/attendance)
# ----------------------------------------------------------------------------

# School timezone — used to work out "today" and the current lesson.
SCHOOL_TIMEZONE="Asia/Tashkent"

# The head teacher account created by `npm run db:seed:attendance`.
ATTENDANCE_HEAD_LOGIN="head"
ATTENDANCE_HEAD_PASSWORD="Head12345!"
ATTENDANCE_HEAD_NAME="Sodiq School Head Teacher"

# Password given to every seeded teacher account (change it after first login).
ATTENDANCE_TEACHER_PASSWORD="Teacher12345!"

# Telegram bot for student-move requests (optional — the app works without it).
# TELEGRAM_BOT_TOKEN: from @BotFather.
# TELEGRAM_HEAD_CHAT_ID: the head teacher's chat id (message @userinfobot to get it).
# TELEGRAM_WEBHOOK_SECRET: any long random string; it becomes part of the webhook URL.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_HEAD_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""
