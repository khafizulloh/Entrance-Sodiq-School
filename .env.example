# ----------------------------------------------------------------------------
# Sodiq School Entrance Test — Environment Variables
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/sodiq_school
# Supabase: use the "Connection string" (URI) from your project settings.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sodiq_school?schema=public"

# Secret used to sign admin session JWTs. Use a long random string in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# Credentials for the default admin user created by the seed script.
ADMIN_EMAIL="admin@sodiqschool.uz"
ADMIN_PASSWORD="Admin12345!"
ADMIN_NAME="Sodiq School Admin"
