// Prisma schema for the Sodiq School Entrance Test platform.
// Database: PostgreSQL (works with local Postgres or Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Admin users — staff who can log into the dashboard.
// ----------------------------------------------------------------------------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Test — one test per grade. Holds the timer and active flag.
// ----------------------------------------------------------------------------
model Test {
  id           String   @id @default(cuid())
  grade        Int      @unique // grades 2..11
  title        String
  description  String?
  timeLimitSec Int      @default(900) // test duration in seconds (admin editable)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions   Question[]
  submissions Submission[]
}

// ----------------------------------------------------------------------------
// Question — a multiple-choice question that belongs to one test.
// ----------------------------------------------------------------------------
model Question {
  id        String   @id @default(cuid())
  testId    String
  text      String
  order     Int      @default(0)
  // Source publisher the question is taken from: Cambridge / Oxford / Pearson.
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test    Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  options Option[]
  answers StudentAnswer[]

  @@index([testId])
}

// ----------------------------------------------------------------------------
// Option — one of the A/B/C/D choices for a question.
// ----------------------------------------------------------------------------
model Option {
  id         String  @id @default(cuid())
  questionId String
  label      String // "A" | "B" | "C" | "D"
  text       String
  isCorrect  Boolean @default(false)

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]

  @@index([questionId])
}

// ----------------------------------------------------------------------------
// Student — personal info collected before the test.
// ----------------------------------------------------------------------------
model Student {
  id             String   @id @default(cuid())
  fullName       String
  phone          String
  parentPhone    String
  grade          Int
  previousSchool String?
  branch         String?
  telegram       String?
  dateOfBirth    DateTime?
  // When true, this student is allowed to retake the test (admin override).
  allowRetake    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions Submission[]

  @@index([phone])
}

// ----------------------------------------------------------------------------
// Submission — a completed test attempt with the computed result.
// ----------------------------------------------------------------------------
model Submission {
  id             String   @id @default(cuid())
  studentId      String
  testId         String
  score          Int // number of correct answers
  totalQuestions Int
  percentage     Float
  level          String // suggested placement level
  durationSec    Int      @default(0)
  createdAt      DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test    Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers StudentAnswer[]

  @@index([studentId])
  @@index([testId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// StudentAnswer — the option a student picked for a question.
// ----------------------------------------------------------------------------
model StudentAnswer {
  id               String  @id @default(cuid())
  submissionId     String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean @default(false)

  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([questionId])
}
